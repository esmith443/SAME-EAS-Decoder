<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SameEasDecoder</AssemblyName>
    <Product>SAME / EAS Decoder</Product>
    <AssemblyTitle>SAME / EAS Decoder</AssemblyTitle>
    <Description>Decodes SAME headers and EAS / NWR attention tones from live audio or recordings.</Description>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SameEasDecoder.Core\SameEasDecoder.Core.csproj" />
  </ItemGroup>

</Project>
