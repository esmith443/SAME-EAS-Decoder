<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgColor">#0E1014</Color>
    <Color x:Key="PanelColor">#14171D</Color>
    <Color x:Key="CardColor">#191D24</Color>
    <Color x:Key="CardHoverColor">#20252E</Color>
    <Color x:Key="FieldColor">#11141A</Color>
    <Color x:Key="StrokeColor">#262B35</Color>
    <Color x:Key="StrokeStrongColor">#363C49</Color>

    <Color x:Key="TextColor">#E8EBF0</Color>
    <Color x:Key="Text2Color">#A3ABB8</Color>
    <Color x:Key="Text3Color">#6E7687</Color>

    <Color x:Key="AccentColor">#4DA3FF</Color>
    <Color x:Key="AccentHoverColor">#71B6FF</Color>
    <Color x:Key="GreenColor">#3DD68C</Color>
    <Color x:Key="AmberColor">#FFB224</Color>
    <Color x:Key="RedColor">#FF5F57</Color>
    <Color x:Key="RoseColor">#FF3D71</Color>
    <Color x:Key="TealColor">#2CC5B5</Color>
    <Color x:Key="SlateColor">#8792A6</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Card" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHover" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="Field" Color="{StaticResource FieldColor}" />
    <SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeStrong" Color="{StaticResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Text2" Color="{StaticResource Text2Color}" />
    <SolidColorBrush x:Key="Text3" Color="{StaticResource Text3Color}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1F4DA3FF" />
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="GreenSoft" Color="#1F3DD68C" />
    <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="AmberSoft" Color="#1FFFB224" />
    <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="RedSoft" Color="#24FF5F57" />
    <SolidColorBrush x:Key="Rose" Color="{StaticResource RoseColor}" />
    <SolidColorBrush x:Key="Teal" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="Slate" Color="{StaticResource SlateColor}" />
    <SolidColorBrush x:Key="LampOff" Color="#2B313C" />
    <SolidColorBrush x:Key="StopButton" Color="#E5484D" />
    <SolidColorBrush x:Key="StopButtonHover" Color="#F2555A" />

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
